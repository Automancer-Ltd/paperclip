+// LOCAL PATCH 2026-09-01 (lane R3 — bill Codex by the auth it actually uses).
+// `resolveCodexBillingType` inferred API billing from the mere presence of an
+// OPENAI_API_KEY environment variable. On 2026-08-24 23:01 the OpenAI *admin* key
+// (bws AUT_OPENAI_ADMIN_KEY, used for usage/billing calls, not inference) was bound
+// as OPENAI_API_KEY on the DevOps agent, and from the next day every DevOps run was
+// filed as `openai` / `metered_api` — the class the ledger and the guardian check
+// treat as real per-token money. It is not: the codex homes' auth.json is a symlink
+// to /home/ubuntu/.codex/auth.json with `auth_mode: "chatgpt"`, no embedded API key,
+// and live rollouts carry a ChatGPT `plan_type: "pro"` rate-limit window. The runs
+// are on Waseem's Codex Pro subscription.
+// Fix: when the CODEX_HOME the run will actually use holds a ChatGPT login and no
+// embedded API key, classify the run as subscription/chatgpt regardless of what the
+// environment carries. A genuine API-key-only codex home still classifies as
+// metered_api. Local execution targets only — a remote target's auth is not here.
+// Backups: acp.js.pre-codex-billing-authmode-20260901,
+//          execute.js.pre-codex-billing-authmode-20260901
+function localPatchCodexHomeUsesChatgptAuth(env) {
+    try {
+        const configured = typeof env.CODEX_HOME === "string" && env.CODEX_HOME.trim().length > 0
+            ? env.CODEX_HOME.trim()
+            : nodePath.join(nodeOs.homedir(), ".codex");
+        const raw = nodeReadFileSync(nodePath.join(configured, "auth.json"), "utf8");
+        const parsed = JSON.parse(raw);
+        if (!parsed || typeof parsed !== "object")
+            return false;
+        const embeddedKey = typeof parsed.OPENAI_API_KEY === "string" && parsed.OPENAI_API_KEY.trim().length > 0;
+        if (embeddedKey)
+            return false;
+        const tokens = parsed.tokens;
+        const hasChatgptTokens = !!tokens
+            && typeof tokens === "object"
+            && typeof tokens.access_token === "string"
+            && tokens.access_token.trim().length > 0;
+        return parsed.auth_mode === "chatgpt" || hasChatgptTokens;
+    }
+    catch {
+        return false;
+    }
+}
+// END LOCAL PATCH 2026-09-01 (lane R3)
